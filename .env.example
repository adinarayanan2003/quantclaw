# QuantClaw .env example
#
# Quick start:
# 1) Copy this file to `.env` for local runs from this repo.
# 2) Fill only the values you use.
# 3) Keep real secrets out of git.
#
# Env-source precedence for environment variables (highest -> lowest):
# process env, ./.env, ~/.quantclaw/.env, then quantclaw.json `env` block.
# Inherited OPENCLAW_* names remain accepted as legacy fallbacks where needed.
# Existing non-empty process env vars are not overridden by dotenv/config env loading.
# Note: direct config keys (for example `gateway.auth.token` or channel tokens in openclaw.json)
# are resolved separately from env loading and often take precedence over env fallbacks.

# -----------------------------------------------------------------------------
# Gateway auth + paths
# -----------------------------------------------------------------------------
# Required if the gateway binds beyond loopback. Leave blank to have QuantClaw
# auto-generate a token on first start, or provide your own using
# `openssl rand -hex 32`. The gateway will refuse to start if this is set to
# the documented example placeholder, so never copy-paste an example value
# from docs or tutorials into this file verbatim.
QUANTCLAW_GATEWAY_TOKEN=

# Optional alternative auth mode (use token OR password).
# QUANTCLAW_GATEWAY_PASSWORD=

# Optional path overrides (defaults shown for reference).
# QUANTCLAW_STATE_DIR=~/.quantclaw
# QUANTCLAW_CONFIG_PATH=~/.quantclaw/quantclaw.json
# QUANTCLAW_HOME=~

# Allowlist of extra directories that `$include` directives in quantclaw.json may
# resolve files from. Path-list separated (':' on POSIX, ';' on Windows). Each
# entry is tilde-expanded. Without this, `$include` is confined to the directory
# containing quantclaw.json.
# QUANTCLAW_INCLUDE_ROOTS=/etc/quantclaw/shared:~/.quantclaw/shared

# Optional: import missing keys from your login shell profile.
# QUANTCLAW_LOAD_SHELL_ENV=1
# QUANTCLAW_SHELL_ENV_TIMEOUT_MS=15000

# -----------------------------------------------------------------------------
# QuantClaw trading alpha
# -----------------------------------------------------------------------------
# Paper/research mode is the default. Live trading must be explicitly enabled.
# Keep order limits small while this path is alpha.
# QUANTCLAW_LIVE_TRADING=1
# QUANTCLAW_LIVE_EXCHANGE=binance
# QUANTCLAW_MAX_ORDER_NOTIONAL=100
# BINANCE_API_KEY=
# BINANCE_API_SECRET=

# -----------------------------------------------------------------------------
# Model provider API keys (set at least one)
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# OPENROUTER_API_KEY=sk-or-...
# QUANTCLAW_LIVE_OPENAI_KEY=sk-...
# QUANTCLAW_LIVE_ANTHROPIC_KEY=sk-ant-...
# QUANTCLAW_LIVE_GEMINI_KEY=...
# OPENAI_API_KEY_1=...
# ANTHROPIC_API_KEY_1=...
# GEMINI_API_KEY_1=...
# GOOGLE_API_KEY=...
# OPENAI_API_KEYS=sk-1,sk-2
# ANTHROPIC_API_KEYS=sk-ant-1,sk-ant-2
# GEMINI_API_KEYS=key-1,key-2

# Optional additional providers
# ZAI_API_KEY=...
# AI_GATEWAY_API_KEY=...
# TOKENHUB_API_KEY=...
# LKEAP_API_KEY=...
# MINIMAX_API_KEY=...
# SYNTHETIC_API_KEY=...

# -----------------------------------------------------------------------------
# Channels (only set what you enable)
# -----------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=123456:ABCDEF...
# DISCORD_BOT_TOKEN=...
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...

# Optional channel env fallbacks
# MATTERMOST_BOT_TOKEN=...
# MATTERMOST_URL=https://chat.example.com
# ZALO_BOT_TOKEN=...
# QUANTCLAW_TWITCH_ACCESS_TOKEN=oauth:...

# -----------------------------------------------------------------------------
# Tools + voice/media (optional)
# -----------------------------------------------------------------------------
# BRAVE_API_KEY=...
# PERPLEXITY_API_KEY=pplx-...
# FIRECRAWL_API_KEY=...

# ELEVENLABS_API_KEY=...
# XI_API_KEY=...  # alias for ElevenLabs
# INWORLD_API_KEY=...
# DEEPGRAM_API_KEY=...
